# Server Configuration
PORT=5000
NODE_ENV=development

# LLM Provider Configuration (OpenAI, OpenRouter, Groq, Gemini OpenAI-compatible, Ollama, etc.)
# If left empty, the application will use its built-in intelligent fallback mode for testing.
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
